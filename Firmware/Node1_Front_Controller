#include <WiFi.h> // 引入無線網路函式庫
#include <esp_now.h> // 引入無線點對點通訊函式庫
#include <esp_wifi.h> // 引入底層頻道設定函式庫

const int PIN_BRAKE = 0; // 煞車磁簧開關輸入腳位
const int PIN_LEFT = 1; // 左轉方向燈開關輸入腳位
const int PIN_RIGHT = 3; // 右轉方向燈開關輸入腳位
const int PIN_LED_L = 6; // 車頭左側盲區警示燈腳位
const int PIN_LED_R = 7; // 車頭右側盲區警示燈腳位
const int PIN_BUZZER = 10; // 預留有源蜂鳴器輸出腳位

uint8_t helmetMac[] = {0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF}; // 請替換為安全帽端Node3實際MAC位址

const unsigned long DEBOUNCE_MS = 20; // 開關軟體防抖動確認時間毫秒
const unsigned long SEND_INTERVAL_MS = 50; // 發送控制封包間隔時間毫秒
const unsigned long REAR_TIMEOUT_MS = 500; // 車尾雷達斷線保護超時時間毫秒
const unsigned long BLINK_INTERVAL_MS = 500; // 斷線警示燈1Hz慢閃半週期毫秒

int lastRawBrake = LOW; // 記錄上次煞車原始電位
int stableBrake = LOW; // 記錄去抖後煞車穩定電位
unsigned long brakeTime = 0; // 記錄煞車狀態變動時間點

int lastRawLeft = HIGH; // 記錄上次左轉原始電位
int stableLeft = HIGH; // 記錄去抖後左轉穩定電位
unsigned long leftTime = 0; // 記錄左轉狀態變動時間點

int lastRawRight = HIGH; // 記錄上次右轉原始電位
int stableRight = HIGH; // 記錄去抖後右轉穩定電位
unsigned long rightTime = 0; // 記錄右轉狀態變動時間點

volatile char rearState = '0'; // 儲存車尾回傳的盲區狀態字元
volatile unsigned long lastRearRxTime = 0; // 記錄最後收到車尾封包的時間點

unsigned long lastSendTime = 0; // 記錄上次發送封包給安全帽的時間點
unsigned long lastBlinkTime = 0; // 記錄上次斷線閃爍切換的時間點
bool blinkState = false; // 記錄目前斷線警示燈亮滅狀態

#if defined(ESP_ARDUINO_VERSION_MAJOR) && ESP_ARDUINO_VERSION_MAJOR >= 3 // 判斷是否為新版核心
void onDataRecv(const esp_now_recv_info_t *info, const uint8_t *data, int len) { // 新版無線接收回呼函式
#else // 舊版核心分支
void onDataRecv(const uint8_t *mac, const uint8_t *data, int len) { // 舊版無線接收回呼函式
#endif // 結束版本判斷
  if (len >= 1) { // 確認收到的封包長度有效
    char incoming = (char)data[0]; // 取出封包第一個字元
    if (incoming >= '0' && incoming <= '3') { // 確認字元為合法盲區代碼
      rearState = incoming; // 更新盲區狀態變數
      lastRearRxTime = millis(); // 重置車尾斷線計時器
    } // 結束合法字元判斷
  } // 結束封包長度判斷
} // 結束無線接收回呼函式

void updateInput(int pin, int &lastRaw, int &stableVal, unsigned long &changeTime) { // 通用開關軟體防抖函式
  int raw = digitalRead(pin); // 讀取腳位當下電位
  if (raw != lastRaw) { // 判斷電位是否發生變化
    changeTime = millis(); // 重新記錄變動起始時間
    lastRaw = raw; // 更新上次原始讀值
  } // 結束電位變化判斷
  if (millis() - changeTime >= DEBOUNCE_MS) { // 判斷是否維持穩定達20毫秒
    stableVal = raw; // 確認並更新穩定狀態值
  } // 結束防抖時間判斷
} // 結束防抖函式

void setup() { // 開機初始化函式
  Serial.begin(115200); // 啟動序列埠監控除錯用
  pinMode(PIN_BRAKE, INPUT); // 設定煞車腳為外部上拉輸入
  pinMode(PIN_LEFT, INPUT); // 設定左轉腳為外部上拉輸入
  pinMode(PIN_RIGHT, INPUT); // 設定右轉腳為外部上拉輸入
  pinMode(PIN_LED_L, OUTPUT); // 設定左側盲區燈為輸出
  pinMode(PIN_LED_R, OUTPUT); // 設定右側盲區燈為輸出
  pinMode(PIN_BUZZER, OUTPUT); // 設定預留蜂鳴器為輸出
  digitalWrite(PIN_LED_L, LOW); // 開機預設熄滅左側盲區燈
  digitalWrite(PIN_LED_R, LOW); // 開機預設熄滅右側盲區燈
  digitalWrite(PIN_BUZZER, LOW); // 開機預設關閉蜂鳴器

  WiFi.mode(WIFI_STA); // 切換無線模組為站台模式
  esp_wifi_set_channel(1, WIFI_SECOND_CHAN_NONE); // 強制鎖定無線頻道為1
  Serial.println(WiFi.macAddress()); // 印出本機MAC位址供配對使用

  if (esp_now_init() != ESP_OK) { // 初始化無線點對點協定
    return; // 初始化失敗則提前結束
  } // 結束初始化檢查

  esp_now_register_recv_cb(onDataRecv); // 註冊無線資料接收回呼函式

  esp_now_peer_info_t peerInfo = {}; // 建立安全帽端配對結構體
  memcpy(peerInfo.peer_addr, helmetMac, 6); // 複製安全帽端MAC位址
  peerInfo.channel = 1; // 指定通訊頻道為1
  peerInfo.encrypt = false; // 關閉加密以維持最低延遲
  esp_now_add_peer(&peerInfo); // 將安全帽端加入發射對象名單
} // 結束初始化函式

void loop() { // 主迴圈函式
  unsigned long now = millis(); // 取得目前系統運行毫秒數

  updateInput(PIN_BRAKE, lastRawBrake, stableBrake, brakeTime); // 更新煞車磁簧防抖狀態
  updateInput(PIN_LEFT, lastRawLeft, stableLeft, leftTime); // 更新左轉撥桿防抖狀態
  updateInput(PIN_RIGHT, lastRawRight, stableRight, rightTime); // 更新右轉撥桿防抖狀態

  if (now - lastSendTime >= SEND_INTERVAL_MS) { // 每50毫秒執行一次控制發送
    lastSendTime = now; // 更新發送計時器
    char cmd = 'N'; // 預設控制指令為待機N
    if (stableLeft == LOW) { // 第一優先判斷左轉是否觸發
      cmd = 'L'; // 設定發送字元為左轉L
    } else if (stableRight == LOW) { // 第二優先判斷右轉是否觸發
      cmd = 'R'; // 設定發送字元為右轉R
    } else if (stableBrake == HIGH) { // 第三優先判斷煞車磁鐵是否離開
      cmd = 'B'; // 設定發送字元為煞車B
    } // 結束優先權判定邏輯
    esp_now_send(helmetMac, (uint8_t *)&cmd, sizeof(cmd)); // 無線發送指令給安全帽端
  } // 結束定時發送區塊

  if (now - lastRearRxTime > REAR_TIMEOUT_MS) { // 檢查是否超過500毫秒未收到車尾訊號
    if (now - lastBlinkTime >= BLINK_INTERVAL_MS) { // 檢查是否達到500毫秒閃爍切換時間
      lastBlinkTime = now; // 更新閃爍計時器
      blinkState = !blinkState; // 反轉警示燈亮滅狀態
      digitalWrite(PIN_LED_L, blinkState ? HIGH : LOW); // 同步切換左側警示燈提示斷線
      digitalWrite(PIN_LED_R, blinkState ? HIGH : LOW); // 同步切換右側警示燈提示斷線
    } // 結束閃爍間隔檢查
  } else { // 車尾連線正常時即時顯示盲區狀態
    char state = rearState; // 讀取最新車尾盲區狀態字元
    digitalWrite(PIN_LED_L, (state == '1' || state == '3') ? HIGH : LOW); // 左側或雙側有車時點亮左燈
    digitalWrite(PIN_LED_R, (state == '2' || state == '3') ? HIGH : LOW); // 右側或雙側有車時點亮右燈
  } // 結束盲區顯示與斷線保護邏輯
} // 結束主迴圈函式
